{
  "name": "codex-taskboard",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "start": "node dist/server.js",
    "companion": "node --env-file-if-exists=.env --import tsx apps/companion/src/main.ts",
    "taskctl": "tsx packages/cli/src/main.ts",
    "build": "vite build --config apps/web/vite.config.ts && tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:e2e": "playwright test",
    "test:offline": "tsx scripts/check-offline.ts",
    "test:db": "tsx scripts/test-db.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx apps/server/src/migrate-entry.ts",
    "admin": "node --env-file-if-exists=.env --import tsx apps/server/src/admin-entry.ts",
    "desktop:diagnose": "tsx scripts/diagnose.ts",
    "desktop:prepare": "tsx scripts/package-desktop.ts",
    "desktop:bundle": "node scripts/bundle-desktop.mjs",
    "desktop:build": "pnpm build && pnpm desktop:prepare && pnpm desktop:bundle",
    "release:checksums": "tsx scripts/checksums.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/secure-session": "^8.2.0",
    "@fastify/static": "^10.1.3",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tanstack/react-query": "^5.90.2",
    "commander": "^14.0.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "lucide-react": "^0.544.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.3",
    "embedded-postgres": "^18.1.0-beta.16",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
